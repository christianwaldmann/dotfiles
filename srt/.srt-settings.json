{
  "network": {
    "allowedDomains": [
      "opencode.ai",
      "pypi.org",
      "files.pythonhosted.org",
      "npmjs.org",
      "*.npmjs.org",
      "crates.io",
      "*.crates.io",
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "*.githubcopilot.com",
      "hashicorp.com"
    ],
    "deniedDomains": [],
    "allowAllUnixSockets": true
  },
  "filesystem": {
    "denyRead": [
      "~",
      "~/.ssh",
      "~/.aws",
      "~/.kube",
      "**.env*"
    ],
    "denyWrite": [],
    "allowRead": [
      "~/.config/opencode",
      "~/.local/share/opencode",
      "~/.cache/opencode",
      "~/.local/state/opencode",
      "~/repos/dotfiles/opencode",
      "~/.nvm",
      "."
    ],
    "allowWrite": [
      "~/.local/share/opencode",
      "/tmp",
      "."
    ]
  }
}

